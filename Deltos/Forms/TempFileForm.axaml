<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="clr-namespace:Deltos.Forms"
             x:Class="Deltos.Forms.TempFileForm">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Classes="ToolbarContainer">
            <StackPanel Name="pnlToolBar"
                        Classes="ToolBar"
                        MinHeight="32" />
        </Border>

        <forms:TextEditorForm Name="Editor"
                              Title="Temp Text" />
    </DockPanel>
</UserControl>
