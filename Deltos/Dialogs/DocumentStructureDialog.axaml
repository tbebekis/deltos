<desktop:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:desktop="clr-namespace:Tripous.Desktop;assembly=Tripous.Desktop"
                      x:Class="Deltos.DocumentStructureDialog"
                      Title="Document Structure"
                      Width="560"
                      Height="520"
                      MinWidth="520"
                      MinHeight="460"
                      CanResize="False"
                      ShowInTaskbar="False"
                      WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Margin="16"
          RowSpacing="10">
        <TextBlock Text="The document structure is a template for suggested folder level names. Documents and folders may contain both folders and text files."
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8">
            <ComboBox Name="cboTemplates"
                      Grid.Column="0"
                      MinWidth="300"
                      SelectionChanged="TemplateSelectionChanged" />
            <Button Name="btnAdd"
                    Grid.Column="1"
                    Width="78"
                    Content="Add"
                    Click="Add_Click" />
            <Button Name="btnRemove"
                    Grid.Column="2"
                    Width="78"
                    Content="Remove"
                    Click="Remove_Click" />
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                Padding="8">
            <TreeView Name="tvStructure" />
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="btnOK"
                    Width="90"
                    Content="OK"
                    IsDefault="True"
                    Click="OK_Click" />
            <Button Name="btnCancel"
                    Width="90"
                    Content="Cancel"
                    IsCancel="True"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</desktop:DialogWindow>
