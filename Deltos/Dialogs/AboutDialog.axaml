<desktop:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:desktop="clr-namespace:Tripous.Desktop;assembly=Tripous.Desktop"
                      x:Class="Deltos.AboutDialog"
                      Title="About Deltos"
                      Width="620"
                      Height="430"
                      MinWidth="620"
                      MinHeight="430"
                      CanResize="False"
                      ShowInTaskbar="False"
                      WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto"
          Margin="22"
          RowSpacing="18">
        <Grid ColumnDefinitions="164,*"
              ColumnSpacing="22">
            <Image Grid.Column="0"
                   Width="164"
                   Height="314"
                   VerticalAlignment="Top"
                   Stretch="Uniform"
                   Source="avares://Deltos/Assets/Deltos-InnoSetup.png" />
            <StackPanel Grid.Column="1"
                        Spacing="8">
                <TextBlock Text="Deltos"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="A desktop writing environment for long-form structured projects."
                           TextWrapping="Wrap" />
                <TextBlock Text="Deltos stores projects directly in the file system, preserving the document structure, ordering, and text assets as ordinary folders and files."
                           TextWrapping="Wrap" />
                <TextBlock TextWrapping="Wrap"
                           Margin="0,8,0,0">
                    <Run Text="Theodoros Bebekis is the author of the sci-fi series " />
                    <Run Text="The Corp of the World"
                         FontWeight="Bold" />
                    <Run Text=", published on Amazon." />
                </TextBlock>
                <TextBlock Text="https://www.amazon.com/dp/B0DJH77BDJ"
                           TextWrapping="Wrap"
                           Foreground="#1E6BD6"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           PointerPressed="AmazonLink_PointerPressed" />
                <TextBlock Text="Copyright (c) 2026 Theodoros Bebekis"
                           Margin="0,12,0,0" />
                <TextBlock Name="lblVersion"
                           Text="Version 1.0.0" />
                <TextBlock Text="Licensed under the MIT License." />
                <TextBlock Text="Includes Silk icons by Mark James."
                           FontSize="12"
                           Opacity="0.78"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Name="btnClose"
                    Content="Close"
                    Width="90"
                    IsDefault="True"
                    IsCancel="True"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</desktop:DialogWindow>
