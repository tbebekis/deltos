<desktop:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:desktop="clr-namespace:Tripous.Desktop;assembly=Tripous.Desktop"
                      x:Class="Deltos.CategoryManageDialog"
                      Title="Manage Categories"
                      Width="560"
                      Height="420"
                      MinWidth="520"
                      MinHeight="360"
                      CanResize="False"
                      ShowInTaskbar="False"
                      WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto"
          Margin="16"
          RowSpacing="10">
        <TextBlock Text="Manage component categories."
                   TextWrapping="Wrap" />

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1">
            <ListBox Name="lboCategories"
                     SelectionChanged="CategoriesSelectionChanged"
                     DoubleTapped="CategoriesDoubleTapped" />
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="btnRename"
                    Width="90"
                    Content="Rename"
                    Click="Rename_Click" />
            <Button Name="btnDelete"
                    Width="90"
                    Content="Delete"
                    Click="Delete_Click" />
            <Button Name="btnOK"
                    Width="90"
                    Content="OK"
                    IsDefault="True"
                    Click="OK_Click" />
            <Button Name="btnCancel"
                    Width="90"
                    Content="Cancel"
                    IsCancel="True"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</desktop:DialogWindow>
