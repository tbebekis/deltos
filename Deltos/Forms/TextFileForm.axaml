<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="clr-namespace:Deltos.Forms"
             x:Class="Deltos.Forms.TextFileForm">
    <TabControl Name="pager">
        <TabItem Name="tabText"
                 Header="Text">
            <Grid ColumnDefinitions="*,Auto,*">
                <forms:TextEditorForm Name="EditorText"
                                      Grid.Column="0"
                                      Title="Text" />

                <GridSplitter Grid.Column="1"
                              Width="5"
                              ResizeDirection="Columns" />

                <forms:TextEditorForm Name="EditorText2"
                                      Grid.Column="2"
                                      Title="Text2" />
            </Grid>
        </TabItem>

        <TabItem Name="tabSynopsis"
                 Header="Synopsis">
            <forms:TextEditorForm Name="EditorSynopsis"
                                  Title="Synopsis" />
        </TabItem>

        <TabItem Name="tabDraft"
                 Header="Draft">
            <forms:TextEditorForm Name="EditorDraft"
                                  Title="Draft" />
        </TabItem>
    </TabControl>
</UserControl>
