<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="clr-namespace:Deltos.Forms"
             x:Class="Deltos.Forms.ComponentForm">
    <Grid Name="EditorGrid"
          ColumnDefinitions="*,Auto,*">
        <forms:TextEditorForm Name="EditorText"
                              Grid.Column="0"
                              Title="Text" />

        <GridSplitter Name="Text2Splitter"
                      Grid.Column="1"
                      Width="5"
                      ResizeDirection="Columns" />

        <forms:TextEditorForm Name="EditorText2"
                              Grid.Column="2"
                              Title="Text2" />
    </Grid>
</UserControl>
