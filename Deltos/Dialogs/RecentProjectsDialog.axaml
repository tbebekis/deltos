<desktop:DialogWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:desktop="clr-namespace:Tripous.Desktop;assembly=Tripous.Desktop"
                      x:Class="Deltos.RecentProjectsDialog"
                      Title="Recent Projects"
                      Width="720"
                      Height="420"
                      MinWidth="620"
                      MinHeight="360"
                      CanResize="False"
                      ShowInTaskbar="False"
                      WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto"
          Margin="16"
          RowSpacing="10">
        <TextBlock Text="Select a recent project."
                   TextWrapping="Wrap" />

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1">
            <ListBox Name="lboProjects"
                     SelectionChanged="ProjectsSelectionChanged"
                     DoubleTapped="ProjectsDoubleTapped" />
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="btnRemove"
                    Width="90"
                    Content="Remove"
                    Click="Remove_Click" />
            <Button Name="btnClear"
                    Width="90"
                    Content="Clear All"
                    Click="Clear_Click" />
            <Button Name="btnOK"
                    Width="90"
                    Content="OK"
                    IsDefault="True"
                    Click="OK_Click" />
            <Button Name="btnCancel"
                    Width="90"
                    Content="Cancel"
                    IsCancel="True"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</desktop:DialogWindow>
